{
  "name": "sqlc-ts",
  "version": "0.0.2",
  "description": "Typed TypeScript query functions from sqlc's JSON analysis",
  "keywords": [
    "sqlc",
    "sql",
    "typescript",
    "codegen",
    "postgres",
    "postgresql",
    "sqlite"
  ],
  "license": "MIT",
  "repository": "github:wakita181009/sqlc-ts",
  "homepage": "https://github.com/wakita181009/sqlc-ts#readme",
  "bugs": "https://github.com/wakita181009/sqlc-ts/issues",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sqlc-ts": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "optionalDependencies": {
    "sqlc-ts-darwin-arm64": "workspace:*",
    "sqlc-ts-darwin-x64": "workspace:*",
    "sqlc-ts-linux-arm64": "workspace:*",
    "sqlc-ts-linux-x64": "workspace:*",
    "sqlc-ts-win32-arm64": "workspace:*",
    "sqlc-ts-win32-x64": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && for d in postgres sqlite; do cp src/dialects/$d/runtime.ts dist/dialects/$d/; done",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "fixture": "for d in postgres sqlite; do (cd test/fixture/$d && node ../../../src/cli.ts generate codegen_request.json gen) || exit 1; done",
    "prepare": "husky",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sqlc:fetch": "node scripts/sqlc-binaries.ts fetch",
    "release": "pnpm sqlc:fetch && pnpm -r --include-workspace-root publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
